flowchart LR
  Admin["Person: administrator / HTTP client"]

  subgraph Lab["MTG MODS · Stateless Lab 2"]
    Gateway["Container: Nginx gateway<br/>round-robin / least connections<br/>no sticky sessions"]

    subgraph API["Interchangeable application instances"]
      License1["Container: License Service 1<br/>FastAPI · X-Instance-ID"]
      License2["Container: License Service 2<br/>FastAPI · X-Instance-ID"]
    end

    DBInit["One-shot container: DB schema init"]
    ExpiryWorker["Container: License expiry worker<br/>single background consumer"]
    LicenseDB[("PostgreSQL<br/>shared business state")]
    Redis[("Redis<br/>shared stats cache + distributed lock")]
    Rabbit["RabbitMQ<br/>externalized command queue"]
  end

  Admin -->|HTTP :18020| Gateway
  Gateway -->|HTTP| License1
