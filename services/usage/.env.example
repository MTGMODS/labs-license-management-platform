# --- Local dev (SQLite) ---
# DATABASE_URL=sqlite+aiosqlite:///./usage.db
# DEBUG_MODE=True
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Docker Compose (Postgres) ---
DATABASE_URL=postgresql+asyncpg://mtg_usage:change_me_usage_db@usage-postgres:5432/usage
DATABASE_POSTGRES_URL=postgresql+asyncpg://mtg_usage:change_me_usage_db@usage-postgres:5432/usage
DEBUG_MODE=False
REDIS_URL=redis://redis:6379/0

POSTGRES_USER=mtg_usage
POSTGRES_PASSWORD=change_me_usage_db
POSTGRES_DB=usage

APP_VERSION=1.0
API_VERSION=v1
