# --- Local dev (SQLite) ---
# DATABASE_URL=sqlite+aiosqlite:///./license.db
# DEBUG_MODE=True
# REDIS_URL=redis://127.0.0.1:6379/0
# USER_SERVICE_URL=http://127.0.0.1:8001
# RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# --- Docker Compose (Postgres + RabbitMQ) ---
DATABASE_URL=postgresql+asyncpg://mtg_license:change_me_license_db@license-postgres:5432/licenses
DATABASE_POSTGRES_URL=postgresql+asyncpg://mtg_license:change_me_license_db@license-postgres:5432/licenses
DEBUG_MODE=False
REDIS_URL=redis://redis:6379/0

POSTGRES_USER=mtg_license
POSTGRES_PASSWORD=change_me_license_db
POSTGRES_DB=licenses

RABBITMQ_DEFAULT_USER=mtg_rabbit
RABBITMQ_DEFAULT_PASS=change_me_rabbit
RABBITMQ_URL=amqp://mtg_rabbit:change_me_rabbit@rabbitmq:5672/

JWT_SECRET=change_me_jwt_secret
# Same value as bots/telegram/.env and bots/discord/.env
BOT_SECRET_TOKEN=change_me_bot_token
INTERNAL_SECRET_TOKEN=change_me_internal_token
USER_SERVICE_URL=http://user-service:8000

APP_VERSION=1.0
API_VERSION=v1

# Optional runtime controls. Production defaults preserve the existing behavior.
# Stateless lab replicas override these in docker-compose.stateless.yml.
INITIALIZE_SCHEMA=True
RUN_EXPIRY_WORKER=True
# INSTANCE_ID=license-service-local
# SYNTHETIC_DELAY_MS=0
